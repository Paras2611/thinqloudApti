# =================================================================
# VERCEL FRONTEND ENVIRONMENT CONFIGURATION (.env.vercel)
# Copy & Paste these into: Vercel Dashboard -> Project Settings -> Environment Variables
# =================================================================

# Backend API Root URL (Point to your Render API web service)
VITE_API_URL=https://aptitude-api.onrender.com

# Real-Time WebSocket Endpoint (Render API URL with wss:// protocol)
VITE_SOCKET_URL=wss://aptitude-api.onrender.com

# Platform Application Name
VITE_APP_NAME=Thinqloud Aptitude Test Platform
